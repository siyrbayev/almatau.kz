{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "dist/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/api/(.*)$", "dest": "/api/$1" },

    { "src": "^(?!/api/).*\\.(?:js|css|map|png|jpg|jpeg|gif|svg|webp|ico|txt|json)$", "dest": "/$1" },
    { "src": "^(?!/api/).*", "dest": "/index.html" }
  ]
}
